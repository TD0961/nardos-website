# ==========================================
# TEMER PROPERTY - CONFIGURATION & TRACKING
# ==========================================

# Base Site URL (Update to custom domain when registered e.g. https://temerproperty.com)
NEXT_PUBLIC_SITE_URL=https://temerproperties.com

# ------------------------------------------
# GOOGLE ANALYTICS & GOOGLE SEARCH CONSOLE
# ------------------------------------------
# Google Analytics 4 Measurement ID (Format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Tag Manager Container ID (Optional: GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# ------------------------------------------
# GOOGLE ADS CONVERSION TRACKING
# ------------------------------------------
# Google Ads Conversion ID (Format: AW-XXXXXXXXXX)
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Conversion labels / IDs configured in Google Ads
NEXT_PUBLIC_GOOGLE_ADS_CALL_CONVERSION_ID=
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_CONVERSION_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=

# ------------------------------------------
# CONTACT & NOTIFICATIONS
# ------------------------------------------
# Personal phone number (used for clickable calls and WhatsApp)
NEXT_PUBLIC_CONTACT_PHONE=0938125777
NEXT_PUBLIC_WHATSAPP_PHONE=251938125777

